{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/update_ping.mjs\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/update_ping.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/update_ping.py\" 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/retro_nudge.mjs\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/retro_nudge.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/retro_nudge.py\" 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/onboard_nudge.mjs\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/onboard_nudge.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/onboard_nudge.py\" 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_nudge.mjs\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_nudge.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_nudge.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
