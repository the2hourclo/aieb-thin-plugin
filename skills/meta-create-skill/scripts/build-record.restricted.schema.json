{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIEB front-door restricted operational record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "workspace_id", "status", "step", "revision", "created_at", "updated_at", "storage", "rung", "outstanding_question", "asset_refs", "verified_outputs", "blocker", "outcome"],
  "properties": {
    "schema_version": {"const": 1}, "build_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["active", "awaiting_answer", "paused", "blocked", "completed", "cancelled", "abandoned"]},
    "step": {"enum": ["readiness", "job", "today", "ladder", "assets", "build", "first_run", "handover"]},
    "revision": {"type": "integer", "minimum": 1},
    "material_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "storage": {"type": "object", "additionalProperties": false, "required": ["mode", "source", "disclosed_at_revision"],
      "properties": {"mode": {"const": "restricted"}, "source": {"enum": ["member_choice", "trial_intake_declined", "legacy_reconsent_required", "default_disclosed"]},
        "disclosed_at_revision": {"type": "integer", "minimum": 0}}},
    "rung": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["kind"], "properties": {"kind": {"enum": ["no_build_one_off", "no_build_connect_first", "no_build_extend_existing", "asset", "skill", "connect", "system"]}}}]},
    "outstanding_question": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["question_id", "answer_key", "required"],
      "properties": {"question_id": {"type": "string"}, "answer_key": {"type": "string"}, "required": {"type": "boolean"}}}]},
    "asset_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["asset_id", "path", "content_sha256"],
      "properties": {"asset_id": {"type": "string"}, "path": {"type": "string"}, "content_sha256": {"type": ["string", "null"]}}}},
    "verified_outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "content_sha256"],
      "properties": {"path": {"type": "string"}, "content_sha256": {"type": "string"}}}},
    "blocker": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["code"], "properties": {"code": {"enum": ["prerequisite_needed", "asset_missing", "tool_unavailable", "permission_required", "workspace_partial", "other"]}}}]},
    "outcome": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["kind"], "properties": {"kind": {"type": "string"}}}]}
  }
}
