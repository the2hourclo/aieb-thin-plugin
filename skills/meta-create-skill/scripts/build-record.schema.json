{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIEB front-door build record (full)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "workspace_id", "status", "step", "revision", "created_at", "updated_at", "storage", "goal", "answers", "outstanding_question", "rung", "asset_refs", "verified_outputs", "blocker", "outcome"],
  "properties": {
    "schema_version": {"const": 1}, "build_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["active", "awaiting_answer", "paused", "blocked", "completed", "cancelled", "abandoned"]},
    "step": {"enum": ["readiness", "job", "today", "ladder", "assets", "build", "first_run", "handover"]},
    "revision": {"type": "integer", "minimum": 1},
    "material_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "storage": {"type": "object", "additionalProperties": false, "required": ["mode", "source", "disclosed_at_revision"],
      "properties": {"mode": {"enum": ["full", "restricted"]}, "source": {"enum": ["member_choice", "trial_intake_declined", "legacy_reconsent_required", "default_disclosed"]}, "disclosed_at_revision": {"type": "integer", "minimum": 0}}},
    "goal": {"type": "object", "additionalProperties": false, "required": ["member_words", "normalized"],
      "properties": {"member_words": {"type": "string"}, "normalized": {"type": "string"}}},
    "answers": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["key", "question_id", "value", "provenance", "confirmed_at_revision"],
      "properties": {"key": {"type": "string"}, "question_id": {"type": "string"}, "value": {},
        "provenance": {"enum": ["member_said", "inferred_confirmed", "inferred_unconfirmed", "from_file", "from_map", "from_setup_intake"]},
        "confirmed_at_revision": {"type": "integer", "minimum": 1}}}},
    "outstanding_question": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["question_id", "answer_key", "required", "asked_at_revision", "text"],
      "properties": {"question_id": {"type": "string"}, "answer_key": {"type": "string"}, "required": {"type": "boolean"},
        "asked_at_revision": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}}]},
    "rung": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["kind", "reasons", "evidence", "decided_at_revision", "override"],
      "properties": {"kind": {"enum": ["no_build_one_off", "no_build_connect_first", "no_build_extend_existing", "asset", "skill", "connect", "system"]},
        "reasons": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "decided_at_revision": {"type": "integer", "minimum": 1},
        "override": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
          "required": ["requested_by_member", "reason", "at_revision"],
          "properties": {"requested_by_member": {"const": true}, "reason": {"type": "string"}, "at_revision": {"type": "integer", "minimum": 1}}}]}}}]},
    "asset_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["asset_id", "path", "role", "read_evidence"],
      "properties": {"asset_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "path": {"type": "string"},
        "role": {"enum": ["brand", "voice", "ip", "example", "template", "other"]},
        "read_evidence": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
          "required": ["content_sha256", "read_at_revision"],
          "properties": {"content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "read_at_revision": {"type": "integer", "minimum": 1}}}]}}}},
    "verified_outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "kind", "content_sha256", "verified_at_revision"],
      "properties": {"path": {"type": "string"}, "kind": {"enum": ["skill", "asset", "document"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "verified_at_revision": {"type": "integer", "minimum": 1}}}},
    "blocker": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["code", "detail", "since_revision"],
      "properties": {"code": {"enum": ["prerequisite_needed", "asset_missing", "tool_unavailable", "permission_required", "workspace_partial", "other"]}, "detail": {"type": "string"}, "since_revision": {"type": "integer", "minimum": 1}}}]},
    "outcome": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["kind", "at_revision"],
      "properties": {"kind": {"enum": ["employee_saved", "asset_saved", "done_directly", "extended_existing", "cancelled", "abandoned"]},
        "at_revision": {"type": "integer", "minimum": 1}}}]}
  },
  "$defs": {"evidence": {"type": "object", "additionalProperties": false,
    "required": ["kind", "ref", "content_sha256", "observed_at_revision"],
    "properties": {"kind": {"type": "string"}, "ref": {"type": "string"},
      "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "observed_at_revision": {"type": "integer", "minimum": 1}}}}
}
